<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Only BridgeCameraSearchFilterTest (enduser account). mvn test -Dsuite.file=testng-bridge-camera-search.xml -->
<suite name="Bridge Camera Search Suite" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Bridge Camera Search Tests">
        <classes>
            <class name="tests.ts_bridges.BridgeCameraSearchFilterTest"/>
        </classes>
    </test>
</suite>
