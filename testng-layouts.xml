<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Only LayoutsTest (enduser account). mvn test -Dsuite.file=testng-layouts.xml -->
<suite name="Layouts Suite" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Layout Tests">
        <classes>
            <class name="tests.ts_layouts.LayoutsTest"/>
        </classes>
    </test>
</suite>
