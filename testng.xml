<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Automation Suite" parallel="false">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Reseller Dashboard Tests">
        <classes>
            <class name="tests.ResellerDashboardTest"/>
        </classes>
    </test>

    <test name="Add User Tests">
        <classes>
            <class name="tests.AddUserTest"/>
        </classes>
    </test>

    <test name="Add Bridge Tests">
        <classes>
            <class name="tests.AddBridgeTest"/>
        </classes>
    </test>
</suite>