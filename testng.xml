<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- parallel="false": all bridge tests share one attach ID on one account, and one Appium
     session per thread would fight over the same device locally.
     group-by-instances: BridgesTest uses priorities, which TestNG applies across the whole suite;
     without this its methods could interleave with other classes' and break the one-session-per-class
     lifecycle in BaseTest. -->
<suite name="Mobile Automation Suite" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- Pure unit tests of framework code: no device, no BrowserStack session. -->
    <test name="Framework Unit Tests">
        <classes>
            <class name="listeners.RetryAnalyzerTest"/>
            <class name="listeners.RetryTransformerTest"/>
            <class name="utils.XPathUtilsTest"/>
            <class name="utils.BrowserStackStatusTest"/>
            <class name="base.SessionScopeTest"/>
            <class name="base.AuthSessionTest"/>
            <class name="base.BrowserStackReporterTest"/>
        </classes>
    </test>

    <test name="Reseller Dashboard Tests">
        <classes>
            <class name="tests.ts_dashboard.ResellerDashboardTest"/>
        </classes>
    </test>

    <test name="User Tests">
        <classes>
            <class name="tests.ts_users.AddUserTest"/>
        </classes>
    </test>

    <test name="Bridge Tests">
        <classes>
            <class name="tests.ts_bridges.BridgesTest"/>
            <class name="tests.ts_bridges.BridgeRestartTest"/>
            <class name="tests.ts_bridges.BridgeCameraSearchFilterTest"/>
        </classes>
    </test>

    <test name="Camera Tests">
        <classes>
            <class name="tests.ts_cameras.CameraContextMenuTest"/>
            <class name="tests.ts_cameras.CameraSearchFilterTest"/>
        </classes>
    </test>

    <test name="Layout Tests">
        <classes>
            <class name="tests.ts_layouts.LayoutsTest"/>
        </classes>
    </test>

    <test name="My Profile Tests">
        <classes>
            <class name="tests.ts_my_profile.MyProfileTest"/>
        </classes>
    </test>
</suite>
