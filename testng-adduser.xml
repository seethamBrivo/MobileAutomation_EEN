<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Only AddUserTest (reseller account). mvn test -Dsuite.file=testng-adduser.xml -->
<suite name="Add User Suite" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Add User Tests">
        <classes>
            <class name="tests.ts_users.AddUserTest"/>
        </classes>
    </test>
</suite>
