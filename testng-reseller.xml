<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Only the classes that sign in as the reseller account.
     mvn test -Dsuite.file=testng-reseller.xml -->
<suite name="Reseller Tests Suite" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Reseller Tests">
        <classes>
            <class name="tests.ts_dashboard.ResellerDashboardTest"/>
            <class name="tests.ts_users.AddUserTest"/>
            <class name="tests.ts_bridges.BridgeRestartTest"/>
        </classes>
    </test>
</suite>
