<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quick local check on a connected device: one reseller class (2 tests, shows login reuse) and one
     short enduser class. mvn test -Dsuite.file=testng-local-smoke.xml -->
<suite name="Local Smoke" parallel="false" thread-count="1" group-by-instances="true">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Local Smoke">
        <classes>
            <class name="tests.ts_dashboard.ResellerDashboardTest"/>
            <class name="tests.ts_cameras.CameraSearchFilterTest"/>
        </classes>
    </test>
</suite>
