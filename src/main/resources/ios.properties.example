# iOS Configuration
automationName=XCUITest
# Device configuration for VSP Events tests - iPhone 17 has better card layout detection
deviceName=iPhone 17
platformVersion=26
# Only needed for local execution (ignored for BrowserStack); see 'xcodes'/idevice_id to obtain one.
udid=YOUR_IOS_DEVICE_UDID

# Application Setup
app=src/ios Application/EagleEye.ipa
# The IPA must be uploaded to BrowserStack with -F "ios_app_groups_support=true" (the dashboard toggle alone is not
# enough), otherwise the app cannot read its keychain group and sign-in hangs on a spinner. Re-upload for every new build.
browserstackApp=bs://YOUR_IOS_APP_ID

# Bundle ID
bundleId=com.your.app.bundleid

# Session Behaviors
noReset=false
fullReset=false
newCommandTimeout=120
# NOTE: when noReset is omitted the framework defaults to noReset=true (Appium's own default is
# false). BaseTest.tearDown logs out or terminates the app (needs bundleId) between tests.

# BrowserStack: keep network logs OFF for iOS. With them on, the device traffic goes through BrowserStack's
# logging proxy and the camera video never loads (tiles stay on spinners), although sign-in and the API calls work.
browserstackNetworkLogs=false
