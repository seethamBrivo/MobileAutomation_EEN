# Platform Configuration
platform=android

# Execution Provider (local or browserstack)
executionProvider=local

# Appium Server URL (for local execution)
appiumServerUrl=http://127.0.0.1:4723

# Default Credentials (update with your credentials)
username=your_username
password=your_password

# BrowserStack Configuration
browserstackHubUrl=https://hub-cloud.browserstack.com/wd/hub
browserstackUserName=YOUR_BROWSERSTACK_USERNAME
browserstackAccessKey=YOUR_BROWSERSTACK_ACCESS_KEY
browserstackProjectName=EEN Mobile Automation
browserstackBuildName=Local Debug Build
browserstackSessionName=

# BrowserStack Options
# Debug logs, network logs and video slow every session down. Keep them false for routine runs and
# turn them on while diagnosing a failure.
browserstackDebug=false
browserstackNetworkLogs=false
browserstackVideo=false
browserstackIdleTimeout=120

# Session scope (Android only): class (default) = one Appium session and one login per test class,
# reused by its tests; method = a fresh session, login and logout around every test.
# Can also be passed as -DsessionScope=method
# sessionScope=class
