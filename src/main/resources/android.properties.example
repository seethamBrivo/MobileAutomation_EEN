# Server & Engine Capabilities
automationName=UiAutomator2
platformName=Android

# Platform Version
platformVersion=15

# Device Configuration
deviceName=YOUR_DEVICE_NAME
# REQUIRED for local execution: Device UDID (run 'adb devices' to find it)
# Can be left empty for BrowserStack execution
udid=YOUR_DEVICE_UDID

# Application Setup
# For local execution - update with your APK path
app=C:\\path\\to\\your\\app.apk

# BrowserStack App ID (upload your app to BrowserStack and get the bs:// URL)
browserstackApp=bs://YOUR_APP_ID

# App Package & Activity
# REQUIRED: App package name (e.g., com.een.vms.android)
# Used for both local and BrowserStack execution
appPackage=com.your.package.name
# App activity (optional for BrowserStack, used for local execution)
appActivity=com.your.package.MainActivity

# Session & Execution Behaviors
noReset=true
fullReset=false
dontStopAppOnReset=false
newCommandTimeout=3600
connectHardwareKeyboard=true
# NOTE: when noReset is omitted the framework defaults to noReset=true (Appium's own default is
# false). Login state therefore persists between sessions; BaseTest.tearDown logs out or clears
# the app (mobile: clearApp, needs appPackage) so the next test starts at the sign-in screen.

# Device Rotation & Security
# Enables adb shell commands for device rotation (required by VSP Events tests TC-37646)
# Set to TRUE for CI/test environments, FALSE for production/untrusted environments
# WARNING: Allows arbitrary shell command execution - only enable in trusted infrastructure
allowAdbShell=true
